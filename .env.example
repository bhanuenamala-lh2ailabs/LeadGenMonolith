# LeadGenMonolith consolidated environment. GITIGNORED. Never commit.
# Built from companyOps/.env, RapidActionTeam/.env, hubspot/.env (identical shared keys de-duplicated).

# ---- HubSpot portals (3 separate accounts - distinct keys) ----
HUBSPOT_KEY_COMPANYOPS=
HUBSPOT_KEY_RAT=
HUBSPOT_KEY_MAIN=

# ---- Enrichment / data providers (same value in every repo) ----
APOLLO_API_KEY=
SIGNALHIRE_API_KEY=
APIFY_TOKEN=
GOOGLE_MAPS_API_KEY=
OUTFLO_API_KEY=
MCA_API=
THESTACK_API_KEY=
THESTACK_API_KEY_TWO=

# ---- Other ----
GOOGLE_DOCS_API_KEY=
ANTHROPIC_API_KEY=
CALENDLY_ISHPREET=
GITHUB_PAT=

# ---- Google OAuth/service-account files (live in ./secrets/) ----
GOOGLE_SECRETS_DIR=

# ---- Daily reporting sheet (used every day going forward; read/write via sheets_token.json) ----
SUPPLY_TEAM_MAPPING_SHEET_ID=
